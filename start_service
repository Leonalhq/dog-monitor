#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PID_FILE="$ROOT/data/service.pid"
LOG_FILE="$ROOT/data/service.log"
NODE_BIN=${DOG_MONITOR_NODE:-/usr/local/bin/node}
NPM_BIN=${DOG_MONITOR_NPM:-/usr/local/bin/npm}

is_running() {
  [ -f "$PID_FILE" ] || return 1
  pid=$(cat "$PID_FILE")
  case "$pid" in *[!0-9]*|'') return 1 ;; esac
  kill -0 "$pid" 2>/dev/null
}

start() {
  if is_running; then
    echo "Dog monitor is already running (PID $pid)"
    echo "Dashboard: http://127.0.0.1:3210/ops"
    return
  fi
  [ -x "$NODE_BIN" ] || { echo "Node not found: $NODE_BIN" >&2; exit 1; }
  [ -x "$NPM_BIN" ] || { echo "npm not found: $NPM_BIN" >&2; exit 1; }
  [ -f "$ROOT/.env" ] || { echo "Missing $ROOT/.env" >&2; exit 1; }

  mkdir -p "$ROOT/data"
  cd "$ROOT"
  PATH="$(dirname "$NODE_BIN"):$PATH" "$NPM_BIN" run build
  nohup "$NODE_BIN" --env-file="$ROOT/.env" "$ROOT/dist/src/cli.js" serve >> "$LOG_FILE" 2>&1 &
  pid=$!
  echo "$pid" > "$PID_FILE"
  sleep 2
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "Dog monitor failed to start. See $LOG_FILE" >&2
    tail -n 20 "$LOG_FILE" >&2
    exit 1
  fi
  echo "Dog monitor started (PID $pid)"
  echo "Dashboard: http://127.0.0.1:3210/ops"
  echo "Logs: $LOG_FILE"
}

stop() {
  if ! is_running; then
    echo "Dog monitor is not running"
    return
  fi
  kill "$pid"
  count=0
  while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "Dog monitor did not stop within 10 seconds (PID $pid)" >&2
    exit 1
  fi
  rm -f "$PID_FILE"
  echo "Dog monitor stopped"
}

case "${1:-}" in
  "")
    if is_running; then
      echo "Dog monitor is already running (PID $pid); restarting for an immediate scan"
      stop
    fi
    start
    ;;
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status)
    if is_running; then
      echo "Dog monitor is running (PID $pid)"
      echo "Dashboard: http://127.0.0.1:3210/ops"
    else
      echo "Dog monitor is not running"
      exit 1
    fi
    ;;
  *) echo "Usage: $0 [start|stop|restart|status]" >&2; exit 2 ;;
esac
